			end)
			Library:Connection(Object.MouseButton1Down, function()
				ObjectStroke.Color = Library.Accent
			end)
			Library:Connection(Object.MouseButton1Up, function()
				ObjectStroke.Color = Theme.Stroke
			end)
			Library:Connection(Object.MouseButton1Click, function()
				Button.Callback()
			end)

			return Button
		end
