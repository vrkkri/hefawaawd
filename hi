				Text = Slider.Name or "";
				TextTruncate = Enum.TextTruncate.AtEnd;
			})
			local ValueBox = Create("TextBox", {
				AnchorPoint = Vector2.new(1, 0);
				Position = UDim2.new(1, 0, 0, 0);
				Size = UDim2.new(0, 60, 0, 14);
				BackgroundTransparency = 1;
				FontFace = Library.UIFont;
				TextSize = Library.FontSize;
				TextColor3 = Theme.Text;
				TextXAlignment = Enum.TextXAlignment.Right;
				ClearTextOnFocus = true;
				Text = "";
			}, Holder)
			local Track = Create("TextButton", {
				Name = "Track";
				Position = UDim2.new(0, 0, 0, 21);
				Size = UDim2.new(1, 0, 0, 4);
				BackgroundColor3 = Theme.Element;
				BorderSizePixel = 0;
				AutoButtonColor = false;
				Text = "";
			}, Holder)
			Corner(Track, 2)
			local Fill = Create("Frame", {
				Size = UDim2.new(0, 0, 1, 0);
				BorderSizePixel = 0;
			}, Track)
			Corner(Fill, 2)
			Library:Theme(Fill, "BackgroundColor3")
			local Knob = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5);
				Position = UDim2.new(0, 0, 0.5, 0);
				Size = UDim2.new(0, 10, 0, 10);
				BackgroundColor3 = Color3.new(1, 1, 1);
				BorderSizePixel = 0;
				ZIndex = 2;
			}, Track)
			Corner(Knob, 5)

			local Val = Slider.State
			local function Set(value)
				value = tonumber(value) or Slider.Min
				value = math.clamp(Library:Round(value, Slider.Decimals), Slider.Min, Slider.Max)
				Val = value
				local Alpha = (Slider.Max - Slider.Min) == 0 and 0 or (value - Slider.Min) / (Slider.Max - Slider.Min)
				Fill.Size = UDim2.new(Alpha, 0, 1, 0)
				Knob.Position = UDim2.new(Alpha, 0, 0.5, 0)
				ValueBox.Text = string.format("%.14g", value) .. Slider.Sub
				Title.TextColor3 = value == Slider.Min and Theme.SubText or Theme.Text
				Library.Flags[Slider.Flag] = value
				Slider.Callback(value)
			end
			Set(Slider.State)

			local Sliding = false
			local function Slide(Input)
				local X = Input.Position.X
				local Alpha = math.clamp((X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				Set(Slider.Min + (Slider.Max - Slider.Min) * Alpha)
			end
			Library:Connection(Track.InputBegan, function(Input)
				if IsClick(Input) then
					Sliding = true
					Tween(Knob, 0.1, {Size = UDim2.new(0, 12, 0, 12)})
					Slide(Input)
				end
			end)
			Library:Connection(UserInputService.InputEnded, function(Input)
				if Sliding and IsClick(Input) then
					Sliding = false
					Tween(Knob, 0.1, {Size = UDim2.new(0, 10, 0, 10)})
				end
			end)
			Library:Connection(UserInputService.InputChanged, function(Input)
				if Sliding and IsMove(Input) then
					Slide(Input)
				end
			end)
			Library:Connection(ValueBox.FocusLost, function()
				local Typed = tonumber((ValueBox.Text:gsub("[^%d%.%-]", "")))
				if Typed then
					Set(Typed)
				else
					ValueBox.Text = string.format("%.14g", Val) .. Slider.Sub
				end
			end)

			function Slider:Set(Value)
				Set(Value)
			end
			Flags[Slider.Flag] = Set
			return Slider
		end
		--
		-- Shared body for List (single) and Multibox (multi).
		local function BuildDropdown(SectionObject, Properties, Multi)
			local Dropdown = {
				Window = SectionObject.Window;
				Page = SectionObject.Page;
				Section = SectionObject;
				Open = false;
				Name = Pick(Properties, "Title", "Name", "title");
				Options = Pick(Properties, "options", "Options", "values", "Values") or {"1", "2", "3"};
				State = Pick(Properties, "state", "State", "def", "Def", "default", "Default");
				Callback = Pick(Properties, "callback", "Callback", "callBack", "CallBack") or function() end;
				Flag = Pick(Properties, "flag", "Flag", "pointer", "Pointer") or Library.NextFlag();
				OptionInsts = {};
			}
			if Multi then
				Dropdown.Max = Pick(Properties, "max", "Max", "maximum", "Maximum") or 1
			end

			local Holder = ExpandableHolder(GetParentColumn(SectionObject, Properties), "Dropdown")
			if Dropdown.Name then
				Text(Holder, {
					Size = UDim2.new(1, 0, 0, 14);
					Text = Dropdown.Name;
					LayoutOrder = 1;
				})
			end
			local Box = Create("TextButton", {
				Name = "Box";
				Size = UDim2.new(1, 0, 0, 22);
				BackgroundColor3 = Theme.Element;
				BorderSizePixel = 0;
				AutoButtonColor = false;
				Text = "";
				LayoutOrder = 2;
			}, Holder)
			Corner(Box, 4)
			local BoxStroke = Stroke(Box, Theme.Stroke)
			local Value = Text(Box, {
				Position = UDim2.new(0, 8, 0, 0);
				Size = UDim2.new(1, -28, 1, 0);
				TextColor3 = Theme.Text;
				TextTruncate = Enum.TextTruncate.AtEnd;
			})
			local Arrow = Text(Box, {
				AnchorPoint = Vector2.new(1, 0);
				Position = UDim2.new(1, -8, 0, 0);
				Size = UDim2.new(0, 12, 1, 0);
				TextXAlignment = Enum.TextXAlignment.Right;
				Text = "+";
			})
			local List = Create("ScrollingFrame", {
				Name = "Options";
				Size = UDim2.new(1, 0, 0, 0);
				BackgroundColor3 = Theme.Element;
				BorderSizePixel = 0;
				ScrollBarThickness = 2;
				ScrollBarImageColor3 = Theme.Dim;
				AutomaticCanvasSize = Enum.AutomaticSize.Y;
				CanvasSize = UDim2.new(0, 0, 0, 0);
				Visible = false;
				LayoutOrder = 3;
			}, Holder)
			Corner(List, 4)
			Stroke(List, Theme.Stroke)
			Create("UIPadding", {PaddingTop = UDim.new(0, 3); PaddingBottom = UDim.new(0, 3)}, List)
			Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, List)

			local function Resize()
				local Count = 0
				for _ in next, Dropdown.OptionInsts do
					Count = Count + 1
				end
				List.Size = UDim2.new(1, 0, 0, math.min(Count, 6) * 18 + 6)
			end

			local function SetOpen(bool)
				Dropdown.Open = bool
				List.Visible = bool
				Arrow.Text = bool and "-" or "+"
				BoxStroke.Color = bool and Library.Accent or Theme.Stroke
			end
			Library:Connection(Box.MouseButton1Click, function()
				SetOpen(not Dropdown.Open)
			end)

			local Chosen = Multi and {} or nil

			local function Paint()
				for Option, Inst in next, Dropdown.OptionInsts do
					local Selected
					if Multi then
						Selected = table.find(Chosen, Option) ~= nil
					else
						Selected = Chosen == Option
					end
					Inst.text.TextColor3 = Selected and Library.Accent or Theme.SubText
				end
				if Multi then
					Value.Text = #Chosen == 0 and "none" or table.concat(Chosen, ", ")
				else
					Value.Text = Chosen ~= nil and tostring(Chosen) or "none"
				end
				Value.TextColor3 = (Multi and #Chosen > 0 or (not Multi and Chosen ~= nil)) and Theme.Text or Theme.SubText
			end
			Library:ThemeCallback(function()
				Paint()
				if Dropdown.Open then
					BoxStroke.Color = Library.Accent
				end
			end)

			local function Commit()
				Paint()
				Library.Flags[Dropdown.Flag] = Chosen
				Dropdown.Callback(Chosen)
			end

			local function Click(Option)
				if Multi then
					local Index = table.find(Chosen, Option)
					if Index then
						table.remove(Chosen, Index)
					else
						if #Chosen >= Dropdown.Max then
							table.remove(Chosen, 1)
						end
						table.insert(Chosen, Option)
					end
				else
					Chosen = Option
					SetOpen(false)
				end
				Commit()
			end

			local function CreateOptions(Tbl)
				for Index, Option in next, Tbl do
					local Button = Create("TextButton", {
						Name = "Option";
						Size = UDim2.new(1, 0, 0, 18);
						BackgroundColor3 = Theme.ElementHover;
						BackgroundTransparency = 1;
						BorderSizePixel = 0;
						AutoButtonColor = false;
						Text = "";
						LayoutOrder = Index;
					}, List)
					local Label = Text(Button, {
						Position = UDim2.new(0, 8, 0, 0);
						Size = UDim2.new(1, -16, 1, 0);
						Text = tostring(Option);
						TextTruncate = Enum.TextTruncate.AtEnd;
					})
					Dropdown.OptionInsts[Option] = {button = Button; text = Label}
					Button.MouseEnter:Connect(function()
						Button.BackgroundTransparency = 0
					end)
					Button.MouseLeave:Connect(function()
						Button.BackgroundTransparency = 1
					end)
					Button.MouseButton1Click:Connect(function()
						Click(Option)
					end)
				end
				Resize()
			end
			CreateOptions(Dropdown.Options)

			local function set(option)
				if Multi then
					table.clear(Chosen)
					option = type(option) == "table" and option or {}
					for _, Opt in next, option do
						if table.find(Dropdown.Options, Opt) and #Chosen < Dropdown.Max then
							table.insert(Chosen, Opt)
						end
					end
				else
					if option ~= nil and table.find(Dropdown.Options, option) then
						Chosen = option
					else
						Chosen = nil
					end
				end
				Commit()
			end

			function Dropdown:Set(option)
				set(option)
			end

			function Dropdown:Refresh(tbl)
				tbl = tbl or {}
				for _, Inst in next, Dropdown.OptionInsts do
					Inst.button:Destroy()
				end
				table.clear(Dropdown.OptionInsts)
				Dropdown.Options = table.clone(tbl)
				CreateOptions(tbl)
				if Multi then
					table.clear(Chosen)
				else
					Chosen = nil
				end
				Commit()
			end

			Flags[Dropdown.Flag] = Multi and set or Dropdown
			Dropdown:Set(Dropdown.State)
			return Dropdown
		end

		function Sections:List(Options)
			return BuildDropdown(self, Options or {}, false)
		end
		--
		function Sections:Multibox(Options)
			return BuildDropdown(self, Options or {}, true)
		end
		--
