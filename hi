			local Properties = Options or {}
			local Keybind = {
				Section = self;
				Name = Pick(Properties, "Title", "Name", "title") or "Keybind";
				State = Pick(Properties, "state", "State", "def", "Def", "default", "Default");
				Mode = Pick(Properties, "mode", "Mode") or "Toggle";
				Callback = Pick(Properties, "callback", "Callback", "callBack", "CallBack") or function() end;
				Flag = Pick(Properties, "flag", "Flag", "pointer", "Pointer") or Library.NextFlag();
				Binding = nil;
				Connection = nil;
			}

			local Holder = Create("TextButton", {
				Name = "Keybind";
				Size = UDim2.new(1, 0, 0, 16);
				BackgroundTransparency = 1;
				AutoButtonColor = false;
				Text = "";
			}, GetParentColumn(self, Properties))
			Text(Holder, {
				Size = UDim2.new(1, -80, 1, 0);
				Text = Keybind.Name;
				TextTruncate = Enum.TextTruncate.AtEnd;
			})
			local Controls = Create("Frame", {
				AnchorPoint = Vector2.new(1, 0);
				Position = UDim2.new(1, 0, 0, 0);
				Size = UDim2.new(0, 80, 1, 0);
				BackgroundTransparency = 1;
			}, Holder)
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal;
				HorizontalAlignment = Enum.HorizontalAlignment.Right;
				VerticalAlignment = Enum.VerticalAlignment.Center;
			}, Controls)
			local Pill = KeyPill(Controls, 1)
			BuildKeybind(Keybind, Pill, Holder)
			return Keybind
		end
		--
		function Sections:Textbox(Options)
			local Properties = Options or {}
			local Textbox = {
				Window = self.Window;
				Page = self.Page;
				Section = self;
				Placeholder = Pick(Properties, "placeholder", "Placeholder", "holder", "Holder") or "";
				State = Pick(Properties, "state", "State", "def", "Def", "default", "Default") or "";
				Callback = Pick(Properties, "callback", "Callback", "callBack", "CallBack") or function() end;
				Flag = Pick(Properties, "flag", "Flag", "pointer", "Pointer") or Library.NextFlag();
			}

			local Frame = Create("Frame", {
				Name = "Textbox";
				Size = UDim2.new(1, 0, 0, 22);
				BackgroundColor3 = Theme.Element;
				BorderSizePixel = 0;
			}, GetParentColumn(self, Properties))
			Corner(Frame, 4)
			local FrameStroke = Stroke(Frame, Theme.Stroke)
			local Box = Create("TextBox", {
				Position = UDim2.new(0, 8, 0, 0);
				Size = UDim2.new(1, -16, 1, 0);
				BackgroundTransparency = 1;
				FontFace = Library.UIFont;
				TextSize = Library.FontSize;
				TextColor3 = Theme.Text;
				PlaceholderText = Textbox.Placeholder;
				PlaceholderColor3 = Theme.Dim;
				TextXAlignment = Enum.TextXAlignment.Left;
				ClearTextOnFocus = false;
				ClipsDescendants = true;
				Text = Textbox.State;
			}, Frame)

			Library:Connection(Box.Focused, function()
				FrameStroke.Color = Library.Accent
			end)
			Library:Connection(Box.FocusLost, function()
				FrameStroke.Color = Theme.Stroke
				local Submitted = Box.Text
				Textbox.Callback(Submitted)
				Library.Flags[Textbox.Flag] = Submitted
				Box.Text = ""
			end)

			local function set(str)
				Box.Text = tostring(str or "")
				Library.Flags[Textbox.Flag] = str
				Textbox.Callback(str)
			end
			function Textbox:Set(str)
				set(str)
			end
			Flags[Textbox.Flag] = set
			return Textbox
		end
