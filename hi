-- Nova UI
-- Drop-in replacement for the Crimson UI library: same functions, same arguments,
-- same returned objects and the same config format, with a different layout.
-- Sidebar pages, section tabs across the top, two scrolling columns of cards.
local Library = {}
do
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local CoreGui = game:GetService("CoreGui")

	Library = {
		Open = true;
		Folders = {
			main = "Crimson";
			configs = "Crimson/Configs";
		};
		Accent = Color3.fromRGB(148, 0, 0);
		Pages = {};
		Sections = {};
		Flags = {};
		UnNamedFlags = 0;
		ThemeObjects = {};
		Instances = {};
		Holder = nil;
		ScreenGui = nil;
		Loading = false;
		Keys = {
			[Enum.KeyCode.LeftShift] = "LS",
			[Enum.KeyCode.RightShift] = "RS",
			[Enum.KeyCode.LeftControl] = "LC",
			[Enum.KeyCode.RightControl] = "RC",
			[Enum.KeyCode.LeftAlt] = "LA",
			[Enum.KeyCode.RightAlt] = "RA",
			[Enum.KeyCode.CapsLock] = "CAPS",
			[Enum.KeyCode.One] = "1",
			[Enum.KeyCode.Two] = "2",
			[Enum.KeyCode.Three] = "3",
			[Enum.KeyCode.Four] = "4",
			[Enum.KeyCode.Five] = "5",
			[Enum.KeyCode.Six] = "6",
			[Enum.KeyCode.Seven] = "7",
			[Enum.KeyCode.Eight] = "8",
			[Enum.KeyCode.Nine] = "9",
			[Enum.KeyCode.Zero] = "0",
			[Enum.KeyCode.KeypadOne] = "Num1",
			[Enum.KeyCode.KeypadTwo] = "Num2",
			[Enum.KeyCode.KeypadThree] = "Num3",
			[Enum.KeyCode.KeypadFour] = "Num4",
			[Enum.KeyCode.KeypadFive] = "Num5",
			[Enum.KeyCode.KeypadSix] = "Num6",
			[Enum.KeyCode.KeypadSeven] = "Num7",
			[Enum.KeyCode.KeypadEight] = "Num8",
			[Enum.KeyCode.KeypadNine] = "Num9",
			[Enum.KeyCode.KeypadZero] = "Num0",
			[Enum.KeyCode.Minus] = "-",
			[Enum.KeyCode.Equals] = "=",
			[Enum.KeyCode.Tilde] = "~",
			[Enum.KeyCode.LeftBracket] = "[",
			[Enum.KeyCode.RightBracket] = "]",
			[Enum.KeyCode.RightParenthesis] = ")",
			[Enum.KeyCode.LeftParenthesis] = "(",
			[Enum.KeyCode.Semicolon] = ";",
			[Enum.KeyCode.Quote] = "'",
			[Enum.KeyCode.BackSlash] = "\\",
			[Enum.KeyCode.Comma] = ",",
			[Enum.KeyCode.Period] = ".",
			[Enum.KeyCode.Slash] = "/",
			[Enum.KeyCode.Asterisk] = "*",
			[Enum.KeyCode.Plus] = "+",
			[Enum.KeyCode.Backquote] = "`",
			[Enum.UserInputType.MouseButton1] = "MB1",
			[Enum.UserInputType.MouseButton2] = "MB2",
			[Enum.UserInputType.MouseButton3] = "MB3"
		};
		Connections = {};
		UIFont = Font.fromEnum(Enum.Font.Gotham);
		BoldFont = Font.fromEnum(Enum.Font.GothamBold);
		FontSize = 12;
	}

	-- // Palette
	local Theme = {
		Background = Color3.fromRGB(14, 14, 17);
		Sidebar = Color3.fromRGB(18, 18, 22);
		Card = Color3.fromRGB(21, 21, 26);
		Element = Color3.fromRGB(30, 30, 37);
		ElementHover = Color3.fromRGB(38, 38, 46);
		Stroke = Color3.fromRGB(38, 38, 46);
		Text = Color3.fromRGB(228, 228, 234);
		SubText = Color3.fromRGB(128, 128, 140);
		Dim = Color3.fromRGB(80, 80, 92);
	}

	-- // Internal stores
	local Flags = {}

	Library.__index = Library
	Library.Pages.__index = Library.Pages
	Library.Sections.__index = Library.Sections

	local LocalPlayer = Players.LocalPlayer
	local Mouse = LocalPlayer:GetMouse()

	-- // Helpers
	local function Create(Class, Properties, Parent)
		local Object = Instance.new(Class)
		for Property, Value in next, Properties do
			Object[Property] = Value
		end
		if Parent then
			Object.Parent = Parent
		end
		return Object
	end

	local function Corner(Parent, Radius)
		return Create("UICorner", {CornerRadius = UDim.new(0, Radius or 4)}, Parent)
	end

	local function Stroke(Parent, Color, Thickness)
		return Create("UIStroke", {
			Color = Color or Theme.Stroke;
			Thickness = Thickness or 1;
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
		}, Parent)
	end

	local function Tween(Object, Time, Goal, Style, Direction)
		local Info = TweenInfo.new(Time, Style or Enum.EasingStyle.Quad, Direction or Enum.EasingDirection.Out)
		local Playing = TweenService:Create(Object, Info, Goal)
		Playing:Play()
		return Playing
	end

	local function Text(Parent, Properties)
		local Label = Create("TextLabel", {
			BackgroundTransparency = 1;
			BorderSizePixel = 0;
			FontFace = Library.UIFont;
			TextSize = Library.FontSize;
			TextColor3 = Theme.SubText;
			TextXAlignment = Enum.TextXAlignment.Left;
			Text = "";
		}, Parent)
		for Property, Value in next, Properties or {} do
			Label[Property] = Value
		end
		return Label
	end

	local function Pick(Properties, ...)
		for _, Key in next, {...} do
			if Properties[Key] ~= nil then
				return Properties[Key]
			end
		end
		return nil
	end

	local function GetParentColumn(SectionObject, Options)
		if Options and Options.Side == "Right" then
			return SectionObject.Elements.Right
		end
		return SectionObject.Elements.Left
	end

	local function KeyName(Key)
		if Key == nil or Key == Enum.KeyCode.Unknown then
			return "none"
		end
		local Short = Library.Keys[Key]
		if Short then
			return Short
		end
		local Name = tostring(Key):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
		return Name
	end

	local function IsClick(Input)
		return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch
	end

	local function IsMove(Input)
		return Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch
	end

	-- // Misc Functions
	do
		function Library:Connection(Signal, Callback)
			local Con = Signal:Connect(Callback)
			table.insert(Library.Connections, Con)
			return Con
		end
		--
		function Library:Disconnect(Connection)
			if Connection then
				Connection:Disconnect()
			end
		end
		--
		function Library:Round(Number, Float)
			return Float * math.floor(Number / Float + 0.5)
		end
		--
		function Library.NextFlag()
			Library.UnNamedFlags = Library.UnNamedFlags + 1
			return string.format("%.14g", Library.UnNamedFlags)
		end
		--
		function Library:RGBA(r, g, b, alpha)
			return Color3.fromRGB(r, g, b)
		end
		--
		function Library:Theme(Object, Property)
			table.insert(Library.ThemeObjects, {Object, Property})
			Object[Property] = Library.Accent
			return Object
		end
		--
		function Library:ThemeCallback(Callback)
			table.insert(Library.ThemeObjects, Callback)
			Callback(Library.Accent)
		end
		--
		function Library:ChangeAccent(Color)
			Library.Accent = Color
			for _, Entry in next, Library.ThemeObjects do
				if type(Entry) == "function" then
					pcall(Entry, Color)
				elseif type(Entry) == "table" and Entry[1] and Entry[1].Parent then
					Entry[1][Entry[2]] = Color
				end
			end
		end
		--
		function Library:IsMouseOverFrame(Frame)
			local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize
			return Mouse.X >= AbsPos.X and Mouse.X <= AbsPos.X + AbsSize.X
				and Mouse.Y >= AbsPos.Y and Mouse.Y <= AbsPos.Y + AbsSize.Y
		end
		--
		function Library:MakeDraggable(Object, Handle)
			local Dragging, Start, StartPos = false, nil, nil
			Library:Connection(Handle.InputBegan, function(Input)
				if IsClick(Input) then
					Dragging = true
					Start = Input.Position
					StartPos = Object.Position
				end
			end)
			Library:Connection(UserInputService.InputChanged, function(Input)
				if Dragging and IsMove(Input) then
					local Delta = Input.Position - Start
					Object.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
				end
			end)
			Library:Connection(UserInputService.InputEnded, function(Input)
				if IsClick(Input) then
					Dragging = false
				end
			end)
		end
		--
		-- Same text format as Crimson so configs saved in one library load in the other.
		function Library:GetConfig()
			local Config = ""
			for Index, Value in pairs(self.Flags) do
				if Index ~= "ConfigConfig_List" and Index ~= "ConfigConfig_Load" and Index ~= "ConfigConfig_Save" then
					local Value2 = Value
					local Final = ""
					if typeof(Value2) == "Color3" then
						local hue, sat, val = Value2:ToHSV()
						Final = ("rgb(%s,%s,%s,%s)"):format(hue, sat, val, 1)
					elseif typeof(Value2) == "table" and Value2.Color and Value2.Transparency then
						local hue, sat, val = Value2.Color:ToHSV()
						Final = ("rgb(%s,%s,%s,%s)"):format(hue, sat, val, Value2.Transparency)
					elseif typeof(Value2) == "table" and Value.Mode then
						local Values = Value.current
						Final = ("key(%s,%s,%s)"):format(Values[1] or "nil", Values[2] or "nil", Value.Mode)
					elseif Value2 ~= nil then
						if typeof(Value2) == "boolean" then
							Value2 = ("bool(%s)"):format(tostring(Value2))
						elseif typeof(Value2) == "table" then
							local New = "table("
							for _, Value3 in pairs(Value2) do
								New = New .. tostring(Value3) .. ","
							end
							if New:sub(#New) == "," then
								New = New:sub(0, #New - 1)
							end
							Value2 = New .. ")"
						elseif typeof(Value2) == "string" then
							Value2 = ("string(%s)"):format(Value2)
						elseif typeof(Value2) == "number" then
							Value2 = ("number(%s)"):format(Value2)
						end
						Final = Value2
					end
					Config = Config .. Index .. ": " .. tostring(Final) .. "\n"
				end
			end
			return Config
		end
		--
		function Library:LoadConfig(Config)
			Library.Loading = true
			local Lines = string.split(Config, "\n")
			local Parsed = {}
			for _, Line in pairs(Lines) do
				Line = Line:gsub("\r", "")
				local Split = string.split(Line, ":")
				if Split[1] ~= "ConfigConfig_List" and #Split >= 2 then
					local Value = Split[2]:sub(2, #Split[2])
					if Value:sub(1, 3) == "rgb" then
						Value = string.split(Value:sub(5, #Value - 1), ",")
					elseif Value:sub(1, 3) == "key" then
						local Parts = string.split(Value:sub(5, #Value - 1), ",")
						if Parts[1] == "nil" and Parts[2] == "nil" then
							Parts[1] = nil
							Parts[2] = nil
						end
						Value = Parts
					elseif Value:sub(1, 4) == "bool" then
						Value = Value:sub(6, #Value - 1) == "true"
					elseif Value:sub(1, 5) == "table" then
						Value = string.split(Value:sub(7, #Value - 1), ",")
					elseif Value:sub(1, 6) == "string" then
						Value = Value:sub(8, #Value - 1)
					elseif Value:sub(1, 6) == "number" then
						Value = tonumber(Value:sub(8, #Value - 1))
					end
					Parsed[Split[1]] = Value
				end
			end
			for Flag, Value in pairs(Parsed) do
				if Flags[Flag] then
					task.spawn(function()
						if typeof(Flags[Flag]) == "table" then
							Flags[Flag]:Set(Value)
						else
							Flags[Flag](Value)
						end
					end)
				end
			end
			task.wait(0.1)
			Library.Loading = false
		end
		--
		function Library:SetOpen(bool)
			if typeof(bool) ~= "boolean" or not Library.Holder then
				return
			end
			Library.Open = bool
			local Main = Library.Holder
			local Scale = Main:FindFirstChildOfClass("UIScale")
			if bool then
				Main.Visible = true
				Tween(Main, 0.2, {GroupTransparency = 0})
				if Scale then
					Tween(Scale, 0.2, {Scale = 1})
				end
			else
				local Fade = Tween(Main, 0.2, {GroupTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				if Scale then
					Tween(Scale, 0.2, {Scale = 0.96}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end
				Fade.Completed:Connect(function(State)
					if State == Enum.PlaybackState.Completed and not Library.Open then
						Main.Visible = false
					end
				end)
			end
		end
		--
		function Library:Unload()
			for _, Con in next, Library.Connections do
				pcall(function()
					Con:Disconnect()
				end)
			end
			table.clear(Library.Connections)
			if Library.ScreenGui then
				Library.ScreenGui:Destroy()
				Library.ScreenGui = nil
			end
		end
	end

	-- // Shared building blocks
	-- A row that can grow downward (dropdown lists, colour panels open inline, no clipping).
	local function ExpandableHolder(Parent, Name)
		local Holder = Create("Frame", {
			Name = Name or "Element";
			BackgroundTransparency = 1;
			BorderSizePixel = 0;
			Size = UDim2.new(1, 0, 0, 0);
			AutomaticSize = Enum.AutomaticSize.Y;
		}, Parent)
		Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder;
			Padding = UDim.new(0, 4);
		}, Holder)
		return Holder
	end

	-- Colour picker panel. Returns the swatch button, the panel and a setter.
	local function BuildPicker(SwatchParent, PanelParent, Default, Flag, Callback, LayoutOrder)
		local Swatch = Create("TextButton", {
			Name = "Swatch";
			Size = UDim2.new(0, 22, 0, 12);
			BackgroundColor3 = Default;
			BorderSizePixel = 0;
			AutoButtonColor = false;
			Text = "";
			LayoutOrder = LayoutOrder or 1;
		}, SwatchParent)
		Corner(Swatch, 3)
		Stroke(Swatch, Theme.Stroke)

		local Panel = Create("Frame", {
			Name = "PickerPanel";
			Size = UDim2.new(1, 0, 0, 112);
			BackgroundColor3 = Theme.Element;
			BorderSizePixel = 0;
			Visible = false;
			LayoutOrder = 50;
		}, PanelParent)
		Corner(Panel, 4)
		Stroke(Panel, Theme.Stroke)

		local SatVal = Create("TextButton", {
			Name = "SatVal";
			Position = UDim2.new(0, 6, 0, 6);
			Size = UDim2.new(1, -30, 1, -30);
			BackgroundColor3 = Color3.fromHSV(0, 1, 1);
			BorderSizePixel = 0;
			AutoButtonColor = false;
			Text = "";
		}, Panel)
		Corner(SatVal, 3)
		local White = Create("Frame", {
			Size = UDim2.new(1, 0, 1, 0);
			BackgroundColor3 = Color3.new(1, 1, 1);
			BorderSizePixel = 0;
		}, SatVal)
		Corner(White, 3)
		Create("UIGradient", {
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)});
		}, White)
		local Black = Create("Frame", {
			Size = UDim2.new(1, 0, 1, 0);
			BackgroundColor3 = Color3.new(0, 0, 0);
			BorderSizePixel = 0;
		}, SatVal)
		Corner(Black, 3)
		Create("UIGradient", {
			Rotation = 90;
			Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)});
		}, Black)
		local SatCursor = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5);
			Size = UDim2.new(0, 6, 0, 6);
			BackgroundColor3 = Color3.new(1, 1, 1);
			BorderSizePixel = 0;
			ZIndex = 3;
		}, SatVal)
		Corner(SatCursor, 3)
		Stroke(SatCursor, Color3.new(0, 0, 0))

		local HueBar = Create("TextButton", {
			Name = "Hue";
			Position = UDim2.new(1, -18, 0, 6);
			Size = UDim2.new(0, 12, 1, -30);
			BackgroundColor3 = Color3.new(1, 1, 1);
			BorderSizePixel = 0;
			AutoButtonColor = false;
			Text = "";
		}, Panel)
		Corner(HueBar, 3)
		local HueKeys = {}
		for Index = 0, 6 do
			table.insert(HueKeys, ColorSequenceKeypoint.new(Index / 6, Color3.fromHSV(Index / 6 % 1, 1, 1)))
		end
		HueKeys[#HueKeys] = ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1))
		Create("UIGradient", {Rotation = 90; Color = ColorSequence.new(HueKeys)}, HueBar)
		local HueCursor = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5);
			Position = UDim2.new(0.5, 0, 0, 0);
			Size = UDim2.new(1, 4, 0, 2);
			BackgroundColor3 = Color3.new(1, 1, 1);
			BorderSizePixel = 0;
			ZIndex = 3;
		}, HueBar)

		local HexBox = Create("TextBox", {
			Position = UDim2.new(0, 6, 1, -20);
			Size = UDim2.new(1, -12, 0, 14);
			BackgroundTransparency = 1;
			FontFace = Library.UIFont;
			TextSize = 11;
			TextColor3 = Theme.SubText;
			TextXAlignment = Enum.TextXAlignment.Left;
			ClearTextOnFocus = false;
			Text = "";
		}, Panel)

		local Hue, Sat, Val = Default:ToHSV()
		local Current = Default

		local function Render()
			SatVal.BackgroundColor3 = Color3.fromHSV(Hue, 1, 1)
			SatCursor.Position = UDim2.new(Sat, 0, 1 - Val, 0)
			HueCursor.Position = UDim2.new(0.5, 0, Hue, 0)
			Swatch.BackgroundColor3 = Current
			HexBox.Text = "#" .. Current:ToHex():upper()
		end

		local function Apply(Fire)
			Current = Color3.fromHSV(Hue, Sat, Val)
			Render()
			if Flag then
				Library.Flags[Flag] = Current
			end
			if Fire then
				Callback(Current)
			end
		end

		local function Set(Color)
			if type(Color) == "table" then
				Color = Color3.fromHSV(tonumber(Color[1]) or 0, tonumber(Color[2]) or 0, tonumber(Color[3]) or 0)
			elseif type(Color) == "string" then
				local Ok, Parsed = pcall(Color3.fromHex, Color)
				Color = Ok and Parsed or nil
			end
			if typeof(Color) ~= "Color3" then
				return
			end
			local NewHue, NewSat, NewVal = Color:ToHSV()
			-- greys carry no hue; keep the slider where it was
			if NewSat > 0 and NewVal > 0 then
				Hue = NewHue
			end
			Sat, Val = NewSat, NewVal
			Apply(true)
		end

		local DraggingSV, DraggingHue = false, false
		local function UpdateSV(Position)
			Sat = math.clamp((Position.X - SatVal.AbsolutePosition.X) / SatVal.AbsoluteSize.X, 0, 1)
			Val = 1 - math.clamp((Position.Y - SatVal.AbsolutePosition.Y) / SatVal.AbsoluteSize.Y, 0, 1)
			Apply(true)
		end
		local function UpdateHue(Position)
			Hue = math.clamp((Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 0.999)
			Apply(true)
		end
		local function MousePos(Input)
			if Input.UserInputType == Enum.UserInputType.Touch then
				return Vector2.new(Input.Position.X, Input.Position.Y)
			end
			return UserInputService:GetMouseLocation() - Vector2.new(0, game:GetService("GuiService"):GetGuiInset().Y)
		end

		Library:Connection(SatVal.InputBegan, function(Input)
			if IsClick(Input) then
				DraggingSV = true
				UpdateSV(MousePos(Input))
			end
		end)
		Library:Connection(HueBar.InputBegan, function(Input)
			if IsClick(Input) then
				DraggingHue = true
				UpdateHue(MousePos(Input))
			end
		end)
		Library:Connection(UserInputService.InputChanged, function(Input)
			if IsMove(Input) then
				if DraggingSV then
					UpdateSV(MousePos(Input))
				elseif DraggingHue then
					UpdateHue(MousePos(Input))
				end
			end
		end)
		Library:Connection(UserInputService.InputEnded, function(Input)
			if IsClick(Input) then
				DraggingSV = false
				DraggingHue = false
			end
		end)
		Library:Connection(HexBox.FocusLost, function()
			local Ok, Parsed = pcall(Color3.fromHex, (HexBox.Text:gsub("#", "")))
			if Ok and Parsed then
				Set(Parsed)
			else
				Render()
			end
		end)
		Library:Connection(Swatch.MouseButton1Click, function()
			Panel.Visible = not Panel.Visible
		end)

		Render()
		if Flag then
			Library.Flags[Flag] = Current
		end
		Callback(Current)

		return Swatch, Panel, Set
	end

	-- Keybind logic shared by Sections:Keybind and Toggle:Keybind. Mirrors Crimson's behaviour.
	local function BuildKeybind(Keybind, KeyButton, ModeOwner)
		local Key
		local State = false
		local Cycle = Keybind.Mode == "Hold" and 1 or 2

		local function Render()
			local Letter = Keybind.Mode == "Hold" and "H" or "T"
			KeyButton.Text = (Keybind.Binding and "..." or KeyName(Key)) .. "  " .. Letter
		end

		local function set(newkey)
			if string.find(tostring(newkey), "Enum") then
				if Keybind.Connection then
					Keybind.Connection:Disconnect()
					Keybind.Connection = nil
					if Keybind.Flag then
						Library.Flags[Keybind.Flag] = false
					end
					Keybind.Callback(false)
				end
				if type(newkey) == "string" then
					if newkey:find("Enum.KeyCode.") then
						newkey = Enum.KeyCode[(newkey:gsub("Enum.KeyCode.", ""))]
					elseif newkey:find("Enum.UserInputType.") then
						newkey = Enum.UserInputType[(newkey:gsub("Enum.UserInputType.", ""))]
					end
				end
				if newkey == Enum.KeyCode.Backspace then
					Key = nil
				elseif newkey ~= nil then
					Key = newkey
				end
				Library.Flags[Keybind.Flag .. "_KEY"] = newkey
				Render()
			elseif newkey == "Toggle" or newkey == "Hold" then
				Library.Flags[Keybind.Flag .. "_KEY STATE"] = newkey
				Keybind.Mode = newkey
				Cycle = newkey == "Hold" and 1 or 2
				Render()
			else
				State = newkey
				if Keybind.Flag then
					Library.Flags[Keybind.Flag] = newkey
				end
				Keybind.Callback(newkey)
			end
		end

		set(Keybind.State)
		set(Keybind.Mode)

		Library:Connection(KeyButton.MouseButton1Click, function()
			if Keybind.Binding then
				return
			end
			Keybind.Binding = true
			Render()
			local Listener
			Listener = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement then
					return
				end
				Listener:Disconnect()
				set(input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType)
				task.wait()
				Keybind.Binding = nil
				Render()
			end)
		end)

		local function Matches(inp)
			if Key == nil or Key == Enum.KeyCode.Unknown then
				return false
			end
			return inp.KeyCode == Key or inp.UserInputType == Key
		end

		Library:Connection(UserInputService.InputBegan, function(inp)
			if UserInputService:GetFocusedTextBox() and inp.UserInputType == Enum.UserInputType.Keyboard then
				return
			end
			if Matches(inp) and not Keybind.Binding then
				if Keybind.Mode == "Hold" then
					if Keybind.Flag then
						Library.Flags[Keybind.Flag] = true
					end
					if Keybind.Connection then
						Keybind.Connection:Disconnect()
					end
					Keybind.Connection = Library:Connection(RunService.RenderStepped, function()
						Keybind.Callback(true)
					end)
				elseif Keybind.Mode == "Toggle" then
					State = not State
					if Keybind.Flag then
						Library.Flags[Keybind.Flag] = State
					end
					Keybind.Callback(State)
				end
			end
		end)

		Library:Connection(UserInputService.InputEnded, function(inp)
			if UserInputService:GetFocusedTextBox() and inp.UserInputType == Enum.UserInputType.Keyboard then
				return
			end
			if Keybind.Mode == "Hold" and Matches(inp) and Keybind.Connection then
				Keybind.Connection:Disconnect()
				Keybind.Connection = nil
				if Keybind.Flag then
					Library.Flags[Keybind.Flag] = false
				end
				Keybind.Callback(false)
			end
		end)

		Library:Connection(ModeOwner.MouseButton2Click, function()
			Cycle = Cycle + 1
			if Cycle > 2 then
				Cycle = 1
			end
			set(Cycle == 1 and "Hold" or "Toggle")
		end)

		Library.Flags[Keybind.Flag .. "_KEY"] = Keybind.State
		Library.Flags[Keybind.Flag .. "_KEY STATE"] = Keybind.Mode
		Flags[Keybind.Flag] = set
		Flags[Keybind.Flag .. "_KEY"] = set
		Flags[Keybind.Flag .. "_KEY STATE"] = set

		function Keybind:Set(newkey)
			set(newkey)
		end

		return set
	end

