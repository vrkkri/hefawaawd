				AutoButtonColor = false;
				FontFace = Library.UIFont;
				TextSize = Library.FontSize;
				TextColor3 = Theme.Text;
				Text = Button.Name;
			}, GetParentColumn(self, Properties))
			Corner(Object, 4)
			local ObjectStroke = Stroke(Object, Theme.Stroke)

