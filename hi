				Position = UDim2.new(0, 2, 0.5, -5);
				Size = UDim2.new(0, 10, 0, 10);
				BackgroundColor3 = Theme.SubText;
				BorderSizePixel = 0;
			}, Switch)
			Corner(Knob, 5)

			local function Render(Instant)
				local On = Toggle.Toggled
				local Goal = {Position = On and UDim2.new(0, 14, 0.5, -5) or UDim2.new(0, 2, 0.5, -5); BackgroundColor3 = On and Color3.new(1, 1, 1) or Theme.SubText}
				if Instant then
					Knob.Position = Goal.Position
					Knob.BackgroundColor3 = Goal.BackgroundColor3
				else
					Tween(Knob, 0.15, Goal)
				end
				Switch.BackgroundColor3 = On and Library.Accent or Theme.Element
				SwitchStroke.Color = On and Library.Accent or Theme.Stroke
				Label.TextColor3 = On and Theme.Text or Theme.SubText
			end
			Library:ThemeCallback(function()
				Render(true)
			end)

			local function SetState()
				Toggle.Toggled = not Toggle.Toggled
				Render(false)
				Library.Flags[Toggle.Flag] = Toggle.Toggled
				Toggle.Callback(Toggle.Toggled)
			end

			function Toggle:Keybind(KeyOptions)
				local KeyProperties = KeyOptions or {}
				local Keybind = {
					State = Pick(KeyProperties, "state", "State", "def", "Def", "default", "Default");
					Mode = Pick(KeyProperties, "mode", "Mode") or "Toggle";
					Callback = Pick(KeyProperties, "callback", "Callback", "callBack", "CallBack") or function() end;
					Flag = Pick(KeyProperties, "flag", "Flag", "pointer", "Pointer") or Library.NextFlag();
					Binding = nil;
					Connection = nil;
				}
				local Pill = KeyPill(Controls, 2)
				BuildKeybind(Keybind, Pill, Row)
				return Keybind
			end

			function Toggle:Colorpicker(PickerOptions)
				local PickerProperties = PickerOptions or {}
				local Colorpicker = {
					State = Pick(PickerProperties, "state", "State", "def", "Def", "default", "Default") or Color3.fromRGB(255, 0, 0);
					Alpha = Pick(PickerProperties, "alpha", "Alpha", "transparency", "Transparency") or 1;
					Callback = Pick(PickerProperties, "callback", "Callback", "callBack", "CallBack") or function() end;
					Flag = Pick(PickerProperties, "flag", "Flag", "pointer", "Pointer") or Library.NextFlag();
				}
				Toggle.Colorpickers = Toggle.Colorpickers + 1
				local _, _, Set = BuildPicker(Controls, Holder, Colorpicker.State, Colorpicker.Flag, Colorpicker.Callback, 1 - Toggle.Colorpickers)
				Flags[Colorpicker.Flag] = Set
				function Colorpicker:Set(color)
					Set(color)
				end
				return Colorpicker
			end

			function Toggle.Set(bool)
				bool = type(bool) == "boolean" and bool or false
				if Toggle.Toggled ~= bool then
					SetState()
				end
			end

			Toggle.Set(Toggle.State)
			Render(true)
			Library.Flags[Toggle.Flag] = Toggle.State
			Flags[Toggle.Flag] = Toggle.Set

			Library:Connection(Row.MouseButton1Click, SetState)
			Library:Connection(Row.MouseEnter, function()
				if not Toggle.Toggled then
					Label.TextColor3 = Theme.Text
				end
			end)
			Library:Connection(Row.MouseLeave, function()
				if not Toggle.Toggled then
					Label.TextColor3 = Theme.SubText
				end
			end)
			return Toggle
		end
