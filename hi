			local Button = {
				Window = self.Window;
				Page = self.Page;
				Section = self;
				Name = Pick(Properties, "Title", "Name", "title") or "button";
				Callback = Pick(Properties, "callback", "Callback", "callBack", "CallBack") or function() end;
			}

			local Object = Create("TextButton", {
				Name = "Button";
				Size = UDim2.new(1, 0, 0, 24);
